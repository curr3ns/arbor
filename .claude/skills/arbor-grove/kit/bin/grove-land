#!/usr/bin/env bash
# grove-land — the merge queue's git steps, all in the mirror (never the operator's checkout).
#
#   grove-land prepare <item> <reviewed sha> <message file>
#       Refreshes the mirror, rebases the reviewed head onto the current default branch in a
#       throwaway worktree and squashes it into one commit with the message, as
#       refs/grove/rebased/<item>. Prints {"status": "ok", "commit", "base", "changed"} where
#       "changed" is true when the rebase changed the reviewed diff (the intent gate must look
#       again), or {"status": "conflict", "files": [...]}.
#   grove-land push <item>
#       Pushes refs/grove/rebased/<item> to the default branch as a fast-forward, never forced.
#       Prints {"status": "pushed", "commit"}, {"status": "moved"} when the default branch moved
#       since prepare (prepare again), or {"status": "rejected", "error"} (protected branch, hooks).
#   grove-land pr <item>
#       Pushes refs/grove/rebased/<item> to the branch grove/<item> (forced: grove/* is grove's own)
#       and prints {"status": "pushed", "branch"}; the session opens or updates the pull request.
#   grove-land forget <item>
#       Deletes refs/grove/{wip,rebased}/<item> once the item is done.
source "$(dirname "$0")/grove-lib.sh"
cmd="${1:?usage: grove-land prepare|push|pr|forget <item> ...}"; item="${2:?item required}"
valid_item "$item"
g() { git -C "$MIRROR" "$@"; }
rebased="refs/grove/rebased/$item"
# Commits need an identity even when the operator has none configured globally.
export GIT_COMMITTER_NAME="${GIT_COMMITTER_NAME:-$(git config user.name || echo arbor-grove)}"
export GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-$(git config user.email || echo arbor-grove@localhost)}"
export GIT_AUTHOR_NAME="${GIT_AUTHOR_NAME:-$GIT_COMMITTER_NAME}" GIT_AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-$GIT_COMMITTER_EMAIL}"

case "$cmd" in
prepare)
  reviewed="${3:?reviewed sha required}"; msg="${4:?message file required}"
  [[ "$reviewed" =~ ^[0-9a-f]{40}$ ]] || die "reviewed must be a full commit sha"
  [ -f "$msg" ] || die "no message file $msg"
  g fetch -q --prune origin
  g cat-file -e "$reviewed^{commit}" || die "$reviewed is not in the mirror"
  new_base="$(g rev-parse "refs/heads/$BASE")"
  old_base="$(g merge-base "$new_base" "$reviewed")"
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/grove-land.XXXXXX")"
  trap 'g worktree remove --force "$tmp" >/dev/null 2>&1 || rm -rf "$tmp"; g worktree prune' EXIT
  g worktree add -q --detach "$tmp" "$reviewed"
  if ! git -C "$tmp" -c core.hooksPath=/dev/null rebase -q "$new_base" >/dev/null 2>&1; then
    files="$(git -C "$tmp" diff --name-only --diff-filter=U | jq -Rn '[inputs]')"
    git -C "$tmp" rebase --abort >/dev/null 2>&1 || true
    jq -cn --argjson files "$files" '{status: "conflict", files: $files}'
    exit 0
  fi
  tree="$(git -C "$tmp" rev-parse 'HEAD^{tree}')"
  [ "$tree" != "$(g rev-parse "$new_base^{tree}")" ] || { echo '{"status":"empty"}'; exit 0; }
  commit="$(g commit-tree "$tree" -p "$new_base" -F "$msg")"
  g update-ref "$rebased" "$commit"
  changed=false
  if [ "$old_base" != "$new_base" ]; then
    a="$(g diff --no-renames "$old_base" "$reviewed" | git patch-id --stable | cut -d' ' -f1)"
    b="$(g diff --no-renames "$new_base" "$commit" | git patch-id --stable | cut -d' ' -f1)"
    [ "$a" = "$b" ] || changed=true
  fi
  jq -cn --arg commit "$commit" --arg base "$new_base" --argjson changed "$changed" \
    '{status: "ok", commit: $commit, base: $base, changed: $changed}'
  ;;
push)
  commit="$(g rev-parse -q --verify "$rebased")" || die "nothing prepared for $item"
  remote="$(g ls-remote origin "refs/heads/$BASE" | cut -f1)"
  [ "$remote" = "$(g rev-parse "$commit^")" ] || { echo '{"status":"moved"}'; exit 0; }
  if err="$(g push -q origin "$commit:refs/heads/$BASE" 2>&1)"; then
    g update-ref "refs/heads/$BASE" "$commit"
    jq -cn --arg commit "$commit" '{status: "pushed", commit: $commit}'
  else
    jq -cn --arg error "$(tail -c 2000 <<<"$err")" '{status: "rejected", error: $error}'
  fi
  ;;
pr)
  commit="$(g rev-parse -q --verify "$rebased")" || die "nothing prepared for $item"
  if err="$(g push -q --force origin "$commit:refs/heads/grove/$item" 2>&1)"; then
    jq -cn --arg branch "grove/$item" '{status: "pushed", branch: $branch}'
  else
    jq -cn --arg error "$(tail -c 2000 <<<"$err")" '{status: "rejected", error: $error}'
  fi
  ;;
forget)
  for r in "refs/grove/wip/$item" "$rebased"; do g update-ref -d "$r" 2>/dev/null || true; done
  echo '{"status":"forgotten"}'
  ;;
*) die "unknown command $cmd" ;;
esac
