#!/usr/bin/env bash
# grove-credential: stores the Claude credential agents use (a `claude setup-token` OAuth token or
# an Anthropic API key) in ~/.config/arbor-grove/credential, mode 0600. Run it in your own
# terminal: it reads the value without echoing it, and never takes it as an argument.
set -euo pipefail
file="${GROVE_CREDENTIAL_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/arbor-grove/credential}"
[ -t 0 ] || { echo "grove-credential: run this in a terminal" >&2; exit 1; }
printf 'Claude credential (input hidden): ' >&2
IFS= read -rs value; echo >&2
[ -n "$value" ] || { echo "grove-credential: nothing entered" >&2; exit 1; }
mkdir -p "$(dirname "$file")" && chmod 700 "$(dirname "$file")"
( umask 077; printf '%s' "$value" > "$file.tmp" ) && mv "$file.tmp" "$file"
echo "saved to $file" >&2
