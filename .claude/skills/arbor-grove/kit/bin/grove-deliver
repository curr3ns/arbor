#!/usr/bin/env bash
# grove-deliver <item>   (message JSON on stdin, e.g. a heredoc)
# Delivers one message into the item's read-only inbox, atomically, as <seq>-<type>.json. A message
# without an id gets the next m<n> from state (next_message is advanced). Prints "<file> <id>".
source "$(dirname "$0")/grove-lib.sh"
item="${1:?usage: grove-deliver <item> < message.json}"; valid_item "$item"
inbox="$(item_dir "$item")/in/inbox"
[ -d "$inbox" ] || die "$item has no inbox (not launched)"
msg="$(head -c 16385)"
[ "${#msg}" -le 16384 ] || die "message larger than 16 KiB"
type="$(jq -er 'select(type == "object") | .type' <<<"$msg")" || die "message is not a JSON object with a type"
case "$type" in change-request|cr-reply|criteria|footprint-reply|notice) ;; *) die "unknown message type $type" ;; esac
if [ "$(jq -r '.id // empty' <<<"$msg")" = "" ]; then
  [ -f "$STATE" ] || die "no state at $STATE to number the message from"
  id="m$(jq -r '.next_message // 1' "$STATE")"
  msg="$(jq -c --arg id "$id" '.id = $id' <<<"$msg")"
  state_update '.next_message = ((.next_message // 1) + 1)'
fi
jq -e '.id | test("^m[0-9]{1,12}$")' <<<"$msg" >/dev/null || die "message id must be m<n>"
seq=$(( $(find "$inbox" -maxdepth 1 -name '[0-9]*.json' | wc -l) + 1 ))
name="$(printf '%06d' "$seq")-$type.json"
tmp="$inbox/.tmp-$$"
jq -c . <<<"$msg" > "$tmp" && chmod 644 "$tmp" && mv "$tmp" "$inbox/$name"
echo "$name $(jq -r .id <<<"$msg")"
